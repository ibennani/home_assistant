# Kopiera till .env och fyll i lokalt — committas ALDRIG
# copy .env.example .env

# Home Assistant REST API
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# SSH till Home Assistant OS (valfritt)
HA_SSH_HOST=homeassistant.local
HA_SSH_USER=root
HA_SSH_PORT=22

# Ditt telefonnummer (internationellt, utan +) — för WhatsApp-vitlistning
HA_ALLOWED_PHONE=
