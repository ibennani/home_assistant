unifi_password: "BYT_UT"
unifi_site: "default"
unifi_port: "443"
unifi_verify_ssl: "false"

# REST-anrop från script på HA-servern (ny-enhet-notis)
ha_internal_url: "http://127.0.0.1:8123"
ha_long_lived_token: "BYT_UT"
