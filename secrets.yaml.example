# Mall — kopiera till secrets.yaml lokalt och på HA-servern (/config/secrets.yaml)

some_password: "BYT_UT"

whatsapp_allowed_number: "46701234567"
openai_api_key: "BYT_UT"

# EdgeRouter DHCP (Wi-Fi-flikens klientlista)
edgerouter_host: "192.168.0.1"
edgerouter_username: "BYT_UT"
edgerouter_password: "BYT_UT"

# UniFi Network Controller (SSID i klientlistan)
